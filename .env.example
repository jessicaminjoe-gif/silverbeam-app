# Copy to .env.local and fill in — never commit the real .env.local
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Set as Supabase Edge Function secrets (supabase secrets set), NOT in the app bundle:
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# DAILY_API_KEY=
# EXPO_ACCESS_TOKEN=            # for expo-server-sdk push notifications
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
# FOUNDER_ALERT_PUSH_TOKEN=     # Jessica's device token, beta-only escalation backstop
